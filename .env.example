# SagarSoft Online - Server Environment Variables
# Copy this file to .env and fill in the values

# REQUIRED: PostgreSQL connection URL (Supabase)
SUPABASE_DB_URL=postgresql://username:password@host:5432/postgres

# REQUIRED: Superadmin credentials
SUPERADMIN_EMAIL=your-email@example.com
SUPERADMIN_PASSWORD_HASH=your-pbkdf2-hash-here

# REQUIRED: Session secret (random string, generate with: openssl rand -hex 32)
SUPERADMIN_SESSION_SECRET=your-random-session-secret

# API key for school authentication
SAGARSOFT_API_KEY=your-api-key

# Default school ID
DEFAULT_SCHOOL_ID=SCH-2026-001

# Server port (default: 10000 for Render)
PORT=10000

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://sagarsoftonline.onrender.com,http://localhost:3000

# Database SSL (set to "false" for local development)
DB_SSL_REJECT_UNAUTHORIZED=true
