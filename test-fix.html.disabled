<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>School Fix Test</title>
<style>body{font-family:sans-serif;margin:20px}button{padding:10px 20px;margin:5px;cursor:pointer}.log{border:1px solid #ccc;padding:10px;margin:10px 0;max-height:300px;overflow:auto;background:#f5f5f5;font-family:monospace;font-size:13px}.pass{color:green;font-weight:bold}.fail{color:red;font-weight:bold}</style></head>
<body>
<h2>School Fix Test</h2>
<p>Ye test inline fix ko locally check karta hai (server ki zaroorat nahi)</p>

<div style="margin:10px 0">
  <label>School Name: <input id="schoolNameInput" value="Test School"></label><br>
  <label>Email: <input id="accountUsernameInput" value="test@school.com"></label><br>
  <label>Password: <input id="accountPasswordInput" value="pass123"></label><br>
  <label>School ID: <input id="schoolIdInput" value="SCH-TEST"></label>
</div>

<button class="primary-button" id="activateAccountBtn" type="button">Add School</button>
<button id="simulateEditBtn" type="button">Simulate Edit (SCH-001)</button>
<button id="resetBtn" type="button">Reset Button</button>
<button id="runTestBtn" type="button">Run Auto Test</button>

<div class="log" id="logDiv"></div>
<div id="resultDiv"></div>

<script>
// ===== LOGGING =====
var logDiv = document.getElementById("logDiv");
function log(msg, color) {
  var line = document.createElement("div");
  if (color) line.style.color = color;
  line.textContent = "[" + new Date().toLocaleTimeString() + "] " + msg;
  logDiv.appendChild(line);
  logDiv.scrollTop = logDiv.scrollHeight;
}

// ===== OVERRIDE FETCH TO LOG (no real server call) =====
var capturedRequests = [];
var _origFetch = window.fetch;
window.fetch = function(u, o) {
  capturedRequests.push({ url: typeof u === "string" ? u : u.url, method: o ? o.method : "GET", body: o && o.body ? o.body : null });
  log(">> FETCH would be sent: " + (o ? o.method : "GET") + " " + (typeof u === "string" ? u : u.url), "blue");
  if (o && o.body) log("   Body keys: " + Object.keys(JSON.parse(o.body)).join(", "));
  return Promise.resolve(new Response(JSON.stringify({ success: true, school_id: "SCH-999" }), { status: 200, headers: { "Content-Type": "application/json" } }));
};

// ===== OLD HANDLER (copy from dashboard.js) =====
var apiBase = "";
var activateAccountBtn = document.getElementById("activateAccountBtn");

// ===== INLINE FIX (same code as in server.js) =====
(function(){if("caches" in window){caches.keys().then(function(ks){ks.forEach(function(k){if(k.indexOf("sagarsoft")>=0)caches.delete(k)})})}if("serviceWorker" in navigator){navigator.serviceWorker.getRegistrations().then(function(rs){rs.forEach(function(r){r.unregister()})})}})();
(function(){var _g=Element.prototype.getAttribute;Element.prototype.getAttribute=function(n){if(n==="data-edit-school-id"&&this.id==="activateAccountBtn"&&(this.textContent||"").trim()==="Add School")return null;return _g.call(this,n)}})();
document.addEventListener("click",function(e){var b=e.target.closest("#activateAccountBtn");if(!b||(b.textContent||"").trim()!=="Add School")return;if(b.dataset)delete b.dataset.editSchoolId;var s=document.getElementById("schoolIdInput");if(s)s.value=""},!0);
(function(){var _f=window.fetch;window.fetch=function(u,o){if(typeof u==="string"&&u.indexOf("/api/admin/schools")>=0&&o){if(o.method==="PUT"){var _b2=document.getElementById("activateAccountBtn");if(_b2&&(_b2.textContent||"").trim()==="Add School"){console.log("FIX PUT2POST");o.method="POST";u=""+u.replace(/\/api\/admin\/schools\/[^\/]+$/,"/api/admin/schools")}}if(o.body&&typeof o.body==="string"&&(o.method==="POST"||o.method==="PUT")){try{var _b=JSON.parse(o.body);delete _b.school_id;o.body=JSON.stringify(_b)}catch(e){}}}return _f.call(window,u,o).then(function(r){if(typeof u==="string"&&u.indexOf("/api/admin/schools")>=0&&o&&o.method==="POST"){return r.clone().json().then(function(d){if(d.success&&d.school_id){var btn=document.getElementById("activateAccountBtn");if(btn){btn.textContent="Add School";btn.removeAttribute("data-edit-school-id")}setTimeout(function(){var s=document.getElementById("schoolIdInput");if(s)s.value=d.school_id},200)}return r}).catch(function(){return r})}return r})}})();

// ===== OLD HANDLER CODE (copy from dashboard.js lines 19414-19455) =====
if (activateAccountBtn) {
  activateAccountBtn.addEventListener("click", async function () {
    var editSchoolId = activateAccountBtn.getAttribute("data-edit-school-id");
    var schoolIdInput = document.getElementById("schoolIdInput");
    var nameEl = document.getElementById("schoolNameInput");
    var emailEl = document.getElementById("accountUsernameInput");
    var passEl = document.getElementById("accountPasswordInput");
    var msgEl = document.getElementById("manageSchoolsMessage") || document.getElementById("licenseMessage");
    var isNew = !editSchoolId || editSchoolId === "__NEW__";
    log("Old handler: data-edit-school-id=" + JSON.stringify(editSchoolId) + " -> isNew=" + isNew + " -> method=" + (isNew ? "POST" : "PUT"), "purple");
    if (!nameEl || !nameEl.value.trim()) { if (msgEl) { msgEl.textContent = "School name required."; msgEl.className = "form-message error"; } return; }
    if (!emailEl || !emailEl.value.trim()) { if (msgEl) { msgEl.textContent = "Email required."; msgEl.className = "form-message error"; } return; }
    if (!passEl || !passEl.value.trim()) { if (msgEl) { msgEl.textContent = "Password required."; msgEl.className = "form-message error"; } return; }
    var body = { school_name: nameEl.value.trim(), email: emailEl.value.trim(), password: passEl.value.trim() };
    if (schoolIdInput && schoolIdInput.value.trim()) body.school_id = schoolIdInput.value.trim();
    try {
      var url = apiBase + "/api/admin/schools";
      var method = isNew ? "POST" : "PUT";
      if (!isNew) url += "/" + encodeURIComponent(editSchoolId);
      log("URL: " + method + " " + url, "purple");
      var resp = await fetch(url, { method: method, headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
      var data = await resp.json().catch(function () { return {}; });
      if (data.success) {
        activateAccountBtn.textContent = "Add School";
        activateAccountBtn.removeAttribute("data-edit-school-id");
        if (isNew) {
          var _els = ["schoolNameInput","accountUsernameInput","accountPasswordInput","schoolIdInput"];
          _els.forEach(function (_id) { var _e = document.getElementById(_id); if (_e) _e.value = ""; });
        }
        log("Old handler: SUCCESS - button reset to 'Add School', data-edit-school-id removed", "green");
      }
    } catch (_e) {}
  });
}

// ===== SIMULATE EDIT BUTTON =====
document.getElementById("simulateEditBtn").addEventListener("click", function() {
  var btn = document.getElementById("activateAccountBtn");
  btn.textContent = "Save School";
  btn.setAttribute("data-edit-school-id", "SCH-001");
  document.getElementById("schoolNameInput").value = "Edited School";
  log("EDIT MODE: button='Save School', data-edit-school-id='SCH-001'", "orange");
});

// ===== RESET BUTTON =====
document.getElementById("resetBtn").addEventListener("click", function() {
  var btn = document.getElementById("activateAccountBtn");
  btn.textContent = "Add School";
  btn.removeAttribute("data-edit-school-id");
  document.getElementById("schoolIdInput").value = "";
  capturedRequests = [];
  logDiv.innerHTML = "";
  log("RESET: button='Add School', data-edit-school-id removed", "gray");
});

// ===== AUTO TEST =====
document.getElementById("runTestBtn").addEventListener("click", async function() {
  var resultDiv = document.getElementById("resultDiv");
  resultDiv.innerHTML = "";
  capturedRequests = [];
  log("=== AUTO TEST STARTING ===", "bold");
  var btn = document.getElementById("activateAccountBtn");

  // Helper
  function resetState() {
    btn.textContent = "Add School";
    btn.removeAttribute("data-edit-school-id");
    capturedRequests = [];
  }

  // Test 1: Add School (normal) should send POST
  resetState();
  log("--- Test 1: Click 'Add School' (no data-edit-school-id) ---", "bold");
  document.getElementById("schoolNameInput").value = "School Alpha";
  document.getElementById("accountUsernameInput").value = "alpha@test.com";
  document.getElementById("schoolIdInput").value = "";
  btn.click();
  await new Promise(function(r) { setTimeout(r, 100); });
  var t1 = capturedRequests.length > 0 ? capturedRequests[capturedRequests.length - 1] : null;
  var t1pass = t1 && t1.method === "POST" && t1.url.indexOf("/api/admin/schools") >= 0 && t1.url.indexOf("SCH-001") === -1;
  log("Test 1: method=" + (t1 ? t1.method : "NONE") + " url=" + (t1 ? t1.url : "NONE") + " -> " + (t1pass ? "PASS" : "FAIL"), t1pass ? "green" : "red");

  // Test 2: Add Second School (should also POST)
  resetState();
  log("--- Test 2: Click 'Add School' for second school ---", "bold");
  // Simulate that data-edit-school-id is STALE (bug scenario)
  btn.setAttribute("data-edit-school-id", "SCH-001");
  document.getElementById("schoolNameInput").value = "School Beta";
  document.getElementById("accountUsernameInput").value = "beta@test.com";
  document.getElementById("accountPasswordInput").value = "pass123";
  document.getElementById("schoolIdInput").value = "";
  btn.click();
  await new Promise(function(r) { setTimeout(r, 100); });
  var t2 = capturedRequests.length > 0 ? capturedRequests[capturedRequests.length - 1] : null;
  // Should be POST because fix overrides getAttribute
  var t2pass = t2 && t2.method === "POST" && t2.url.indexOf("/api/admin/schools") >= 0 && t2.url.indexOf("SCH-001") === -1;
  log("Test 2: method=" + (t2 ? t2.method : "NONE") + " url=" + (t2 ? t2.url : "NONE") + " -> " + (t2pass ? "PASS" : "FAIL"), t2pass ? "green" : "red");

  // Test 3: Edit School should send PUT
  resetState();
  log("--- Test 3: Edit (Save School) should send PUT ---", "bold");
  btn.textContent = "Save School";
  btn.setAttribute("data-edit-school-id", "SCH-001");
  document.getElementById("schoolNameInput").value = "School Alpha Edit";
  document.getElementById("accountUsernameInput").value = "alpha@test.com";
  document.getElementById("accountPasswordInput").value = "pass123";
  btn.click();
  await new Promise(function(r) { setTimeout(r, 100); });
  var t3 = capturedRequests.length > 0 ? capturedRequests[capturedRequests.length - 1] : null;
  var t3pass = t3 && t3.method === "PUT" && t3.url.indexOf("SCH-001") >= 0;
  log("Test 3: method=" + (t3 ? t3.method : "NONE") + " url=" + (t3 ? t3.url : "NONE") + " -> " + (t3pass ? "PASS" : "FAIL"), t3pass ? "green" : "red");

  // Summary
  var allPass = t1pass && t2pass && t3pass;
  resultDiv.innerHTML = "<h3>" + (allPass ? "<span class='pass'>ALL TESTS PASSED</span>" : "<span class='fail'>SOME TESTS FAILED</span>") + "</h3>";
  resultDiv.innerHTML += "<pre>Test 1 (Add first school): " + (t1pass ? "PASS - POST" : "FAIL - saw " + (t1 ? t1.method + " " + t1.url : "nothing")) + "</pre>";
  resultDiv.innerHTML += "<pre>Test 2 (Add second school with stale data-edit-school-id): " + (t2pass ? "PASS - POST" : "FAIL - saw " + (t2 ? t2.method + " " + t2.url : "nothing")) + "</pre>";
  resultDiv.innerHTML += "<pre>Test 3 (Edit school should PUT): " + (t3pass ? "PASS - PUT to SCH-001" : "FAIL - saw " + (t3 ? t3.method + " " + t3.url : "nothing")) + "</pre>";

  if (allPass) {
    resultDiv.innerHTML += "<p style='color:green;font-size:18px;font-weight:bold'>FIX WORKING! Deploy kar sakte ho.</p>";
  } else {
    resultDiv.innerHTML += "<p style='color:red;font-size:18px;font-weight:bold'>Fix FAILED. Pehle debug karo.</p>";
  }

  log("=== AUTO TEST COMPLETE ===", "bold");
});
</script>
</body></html>
