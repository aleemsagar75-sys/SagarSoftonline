{
  "name": "sagarsoft-management-system",
  "version": "1.0.0",
  "description": "SagarSoft Management System - Offline Desktop App",
  "main": "electron-main.js",
  "author": "SagarSoft",
  "license": "UNLICENSED",
  "private": true,
    "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:portable": "electron-builder --win portable",
    "dist:portable:skiprebuild": "electron-builder --win portable -c.npmRebuild=false -c.buildDependenciesFromSource=false"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.sagarsoft.management",
    "productName": "SagarSoft Management System",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/app-icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/app-icon-256.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico"
    }
  }
}
