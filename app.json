{
  "expo": {
    "name": "SagarSoft School Management",
    "slug": "sagarsoft-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/SagarSoft.logo.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/SagarSoft.logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1f3a"
    },
    "android": {
      "package": "com.sagarsoft.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/SagarSoft.logo.png",
        "backgroundColor": "#0b1f3a"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.sagarsoft.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-asset"
    ],
    "updates": {
      "enabled": false
    },
    "extra": {
      "eas": {
        "projectId": "aa7b9d59-803b-4b0e-8530-b6d9faf82f91"
      }
    }
  }
}
